+// ---------- Poster PNG ----------
+// Simpan hasil poster (PNG) ke R2: orders/<order>/poster/<name>.png  (name = template + ID pesanan)
+async function handlePosterSave(request, url, env, cors) {
+  const order = url.searchParams.get("order") || "", name = url.searchParams.get("name") || "";
+  if (!ORDER_RE.test(order)) throw new HttpError("Kode order tidak valid", 400);
+  if (!/^[A-Za-z0-9_-]{1,80}$/.test(name)) throw new HttpError("Nama file tidak valid", 400);
+  const buf = await request.arrayBuffer();
+  if (buf.byteLength < 100 || buf.byteLength > 40 * 1024 * 1024) throw new HttpError("Ukuran PNG tidak wajar", 413);
+  const sig = new Uint8Array(buf, 0, 4);
+  if (sig[0] !== 0x89 || sig[1] !== 0x50 || sig[2] !== 0x4e || sig[3] !== 0x47) throw new HttpError("Bukan file PNG", 400);
+  const key = `orders/${order}/poster/${name}.png`;
+  await env.BUCKET.put(key, buf, { httpMetadata: { contentType: "image/png", cacheControl: "no-cache" } });
+  const head = await env.BUCKET.head(key);
+  if (!head || head.size === 0) throw new HttpError("File di R2 kosong", 502);
+  return json({ ok: true, key, size: head.size }, 200, cors);
+}
