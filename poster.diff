+// themes.js (window.POSTER_THEMES, format objek) diubah ke format yang dipakai renderer ini
+function fromThemesJs(src) {
+  const out = { C: [] };
+  Object.entries((src && src.C) || {}).forEach(([id, t]) => {
+    const box = (b) => [b.cx, b.cy, b.w, b.h];
+    const hs = t.labels.slice(0, 12).map((l) => l.h).sort((a, b) => a - b);
+    out.C.push({
+      id, nama: t.name, bg: t.bg, mask: t.mask, w: t.w, h: t.h,
+      slots: t.slots.map((r) => [r.x, r.y, r.w, r.h]),
+      labels: t.labels.map((l) => [l.cx, l.cy]),
+      title: box(t.title), sub: box(t.sub), qr: t.qr,
+      ink: t.title.color, txt: t.labels[0].color,
+      labSize: Math.round(hs[hs.length >> 1] * 1.2), labBig: Math.round(t.labels[12].h * 1.2),
+      tfont: /serif/i.test(t.tf) && !/sans-serif/i.test(t.tf.split(",")[0]) ? "serif" : "sans",
+      sfont: /script|cursive/i.test(t.sf) ? "script" : "sans",
+    });
+  });
+  return out;
+}
+if (window.POSTER_THEMES) { THEMES = fromThemesJs(window.POSTER_THEMES); fillThemes(); draw(); }
